# Cynbit AI Pre-Sales Solution Architect - Environment Variables
# Copy this file to .env and insert your API keys if available.
# The application works automatically with an offline mock engine if no key is supplied!

# LLM Provider Configuration
LLM_PROVIDER=gemini       # Options: "gemini", "openai", "offline"
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Default Pricing & Cost Settings
DEFAULT_HOURLY_COST=45.0          # Internal cost per developer hour (USD)
DEFAULT_HOURLY_BILL_RATE=95.0     # Baseline client billing rate (USD)
DEFAULT_TARGET_MARGIN_PCT=35.0    # Target gross profit margin %
DEFAULT_CONTINGENCY_PCT=15.0      # Buffer for unforeseen technical debt/scope risk

# Server Settings
APP_ENV=development
LOG_LEVEL=INFO
